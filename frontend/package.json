{
	"name": "blog",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"prebuild": "node scripts/generate-sitemap.mjs",
		"build": "vite build",
		"deploy": "sudo chown -R $USER:$USER /var/www/html/blog/ && node scripts/generate-sitemap.mjs && vite build && sudo chown -R www-data:www-data /var/www/html/blog/ && sudo chmod -R 755 /var/www/html/blog/",
		"preview": "vite preview",
		"test:unit": "vitest",
		"lint": "eslint . --fix"
	},
	"dependencies": {
		"@lucide/vue": "^1.31.0",
		"@tailwindcss/vite": "^4.0.12",
		"@unhead/vue": "^3.3.1",
		"axios": "^1.8.3",
		"pinia": "^3.0.1",
		"tailwindcss": "^4.0.12",
		"vue": "^3.5.13",
		"vue-gtag": "^3.7.1",
		"vue-router": "^4.5.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.21.0",
		"@vitejs/plugin-vue": "^5.2.1",
		"@vitest/eslint-plugin": "^1.1.36",
		"@vue/test-utils": "^2.4.6",
		"eslint": "^9.21.0",
		"eslint-plugin-vue": "~10.0.0",
		"globals": "^16.0.0",
		"jsdom": "^26.0.0",
		"terser": "^5.42.0",
		"vite": "^6.2.1",
		"vite-plugin-vue-devtools": "^7.7.2",
		"vitest": "^3.0.8"
	}
}
